NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=<generate-a-long-random-secret-at-least-32-characters>
# Comma-separated frontend origins for local/production deployments
CLIENT_URL=http://localhost:5173,https://bookhub-swart.vercel.app

# Initial admin provisioning (used only by npm run create:admin)
ADMIN_NAME=BookHub Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=0700000000
ADMIN_PASSWORD=<use-a-unique-password-at-least-12-characters>

# Email
RESEND_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# M-Pesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:5000/api/mpesa/callback

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
