{
  "name": "bookhub-server",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" server.js",
    "seed:books": "node seeds/bookSeed.js",
    "create:admin": "node scripts/createAdmin.js",
    "migrate:approve-seller-books": "node scripts/approveExistingSellerBooks.js",
    "migrate:repair-payment-indexes": "node scripts/repairPaymentIndexes.js"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "latest",
    "cloudinary": "^2.11.0",
    "cookie-parser": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-list-endpoints": "^7.1.1",
    "express-mongo-sanitize": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "moment": "^2.30.1",
    "mongoose": "latest",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "resend": "^6.17.2",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "validator": "latest",
    "xss": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "latest"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
